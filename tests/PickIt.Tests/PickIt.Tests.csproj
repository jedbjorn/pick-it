<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the eyedropper's pure geometry and pixel lookup; runs on any OS.
    The add-in project is WPF and Windows-only, so it is not referenced: the files
    under test are compiled into this project as linked source. Anything linked here
    must stay free of WPF, Win32 and Revit API dependencies.
    The Revit configurations of Directory.Build.props (Debug R26, …) apply as they
    are; this project ignores the Revit suffix (CI runs it with -c "Release R26").
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PickIt.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PickIt.Revit\UI\Picking\ScreenSampling.cs" Link="Linked\ScreenSampling.cs" />
    <Compile Include="..\..\src\PickIt.Revit\Model\Rgb.cs" Link="Linked\Rgb.cs" />
  </ItemGroup>

</Project>
