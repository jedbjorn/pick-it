<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:PickIt.Revit.UI.Theming">

    <!--
        Pick-It theme: the part of the Gantt-It family theme the Shift-click menu needs
        (copied from Gantt-It's Theme.xaml, not referenced). Merged by the window; there is
        no WPF Application in Revit.
    -->

    <!--
        Palette: the light or dark brushes (SurfaceBrush, TextBrush, …) of Revit's UI theme,
        read when the window opens. The colours are in UI/Theming/UiPalette.cs.
    -->
    <ResourceDictionary.MergedDictionaries>
        <theming:ThemePalette />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- Text -->
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="MenuGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Focus rings: around a swatch, and inside a menu row -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" StrokeThickness="1.5"
                               Stroke="{StaticResource AccentForegroundBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MenuFocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle RadiusX="2" RadiusY="2" StrokeThickness="1.5"
                               Stroke="{StaticResource AccentForegroundBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A menu row: the family's context-menu item (transparent, hover fill, 2 px corners)
        as a button, so it works in a window of our own.
    -->
    <Style x:Key="MenuButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource MenuFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one-pixel line between groups of menu rows -->
    <Style x:Key="MenuDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        A colour swatch: Gantt-It's chip (3 px corners, a hairline so a swatch the colour of
        the surface still shows, a stronger 2 px outline under the pointer), stretched to
        its cell. Content, if any, is centred on the colour.
    -->
    <Style x:Key="SwatchButton" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chip" CornerRadius="3" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource ChipBorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource ChipHoverBorderBrush}" />
                            <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource ChipHoverBorderBrush}" />
                            <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An empty cell of the recent colours: the swatch's shape, no colour -->
    <Style x:Key="SwatchPlaceholder" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Tooltips: the Windows template with palette colours (light keeps the Windows tooltip colours). -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ToolTipBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ToolTipTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolTipBorderBrush}" />
    </Style>

</ResourceDictionary>
