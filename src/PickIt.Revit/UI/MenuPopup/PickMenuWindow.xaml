<Window x:Class="PickIt.Revit.UI.MenuPopup.PickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick-It" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        FontFamily="Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True" FocusVisualStyle="{x:Null}"
        PreviewKeyDown="OnMenuKeyDown" PreviewMouseDown="OnMenuMouseDown"
        AutomationProperties.AutomationId="PickMenu">
    <!--
        The Shift-click menu: a small popup at the pointer with two views, the menu itself
        and the 2 × 8 grid of Revit's custom colours ("Add to palette…"). Created off-screen
        and moved to the pointer by the code-behind, which also fills the swatch grids.
        The 10 px margin around the card is room for its shadow (ShadowMargin in the code).
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PickIt.Revit;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <!-- The shadow is on a sibling, so the text above it keeps its sharp rendering. -->
        <Border CornerRadius="4" Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="4" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8"
                KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <StackPanel Width="208">

                <!-- The colour the menu acts on: what is on the ribbon button -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CurrentChip" Width="28" Height="28" CornerRadius="3" BorderThickness="1"
                            BorderBrush="{StaticResource ChipBorderBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   AutomationProperties.AutomationId="PickMenu.Current" />
                        <TextBlock x:Name="CurrentDetail" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>

                <!-- View 1: the menu -->
                <StackPanel x:Name="MainView">
                    <TextBlock Text="Recent colours" Style="{StaticResource SectionLabel}" />
                    <UniformGrid x:Name="RecentGrid" Rows="2" Columns="5" Margin="-2,-2,-2,-2"
                                 AutomationProperties.AutomationId="PickMenu.Recent" />

                    <Border Style="{StaticResource MenuDivider}" />

                    <Button x:Name="ClearButton" Style="{StaticResource MenuButton}" Click="OnClear"
                            ToolTip="Take the colour off the ribbon button. The recent colours stay."
                            AutomationProperties.AutomationId="PickMenu.Clear" AutomationProperties.Name="Clear">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE711;" Style="{StaticResource MenuGlyph}" />
                            <TextBlock Grid.Column="1" Text="Clear" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="ClearHistoryButton" Style="{StaticResource MenuButton}" Click="OnClearHistory"
                            ToolTip="Empty the recent colours. The ribbon button keeps its colour."
                            AutomationProperties.AutomationId="PickMenu.ClearHistory" AutomationProperties.Name="Clear history">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE74D;" Style="{StaticResource MenuGlyph}" />
                            <TextBlock Grid.Column="1" Text="Clear history" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource MenuDivider}" />

                    <Button x:Name="AddToPaletteButton" Style="{StaticResource MenuButton}" Click="OnAddToPalette"
                            ToolTip="Store the colour in one of the 16 custom colours of Revit's Color dialog."
                            AutomationProperties.AutomationId="PickMenu.AddToPalette" AutomationProperties.Name="Add to palette">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE790;" Style="{StaticResource MenuGlyph}" />
                            <TextBlock Grid.Column="1" Text="Add to palette…" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource MenuGlyph}" FontSize="10" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- View 2: Revit's custom colours, laid out as in Revit's Color dialog -->
                <StackPanel x:Name="PaletteView" Visibility="Collapsed">
                    <Button x:Name="BackButton" Style="{StaticResource MenuButton}" Click="OnBack"
                            AutomationProperties.AutomationId="PickMenu.Back" AutomationProperties.Name="Back">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72B;" Style="{StaticResource MenuGlyph}" />
                            <TextBlock Grid.Column="1" Text="Back" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource MenuDivider}" />

                    <TextBlock Text="Revit's custom colours" Style="{StaticResource SectionLabel}" />
                    <UniformGrid x:Name="PaletteGrid" Rows="2" Columns="8" Margin="-2,-2,-2,-2"
                                 AutomationProperties.AutomationId="PickMenu.Palette" />

                    <TextBlock x:Name="PaletteHint" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Click a slot to store the colour there. It replaces the slot's colour." />
                    <Grid x:Name="StatusRow" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Margin="0,2,6,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   AutomationProperties.AutomationId="PickMenu.Status" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
